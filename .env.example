# RoadGuard configuration (placeholders only - never commit real values).
#
# NOTE: Spring Boot does NOT read a ".env" file by itself. These are ordinary OPERATING-SYSTEM environment
# variables. Set them in your shell before starting the app, or in your IDE's run configuration:
#   PowerShell :  $env:ROUTING_BASE_URL = "http://localhost:5000"; mvn spring-boot:run
#   cmd.exe    :  set ROUTING_BASE_URL=http://localhost:5000 && mvn spring-boot:run
#   bash       :  ROUTING_BASE_URL=http://localhost:5000 mvn spring-boot:run
# Every variable is OPTIONAL: the defaults work out of the box with no API key.

# --- server / database ---
PORT=8080
DB_URL=jdbc:h2:file:./data/roadguard
DB_USERNAME=sa
DB_PASSWORD=
H2_CONSOLE_ENABLED=false
SESSION_COOKIE_SECURE=false          # set to true when serving over HTTPS

# --- uploads ---
UPLOAD_DIR=./data/uploads

# --- map tiles (browser). Default: OpenStreetMap standard tiles, no key needed ---
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# --- routing (OSRM-compatible). Default: public OSRM demo server (light use only), no key needed ---
ROUTING_BASE_URL=https://router.project-osrm.org

# --- place search (Nominatim-compatible). Please add a contact e-mail as the Nominatim usage policy asks ---
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_CONTACT_EMAIL=
HTTP_USER_AGENT=RoadGuard-CollegeProject/1.0

# --- misc ---
ROADGUARD_TIMEZONE=Asia/Kolkata
SEED_ENABLED=true                    # false = no demo accounts / sample data (recommended outside demos)

# --- deployment (see docs/DEPLOYMENT.md) ---
# First administrator for a real server (use with SEED_ENABLED=false). Both required; created only if the e-mail is new.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Behind an HTTPS reverse proxy (Caddy, nginx, a platform router): framework. Direct access: none.
FORWARD_HEADERS_STRATEGY=none
SEED_DEMO_PASSWORD=password123
SEED_ADMIN_PASSWORD=admin123
